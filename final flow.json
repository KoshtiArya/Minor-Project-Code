        "ui": "",
        "name": "Hospital Live Status",
        "order": 1,
        "width": 0,
        "height": 0,
        "head": "",
        "format": "<template>\n\n    <div class=\"hospital-status-wrapper\">\n\n        <div class=\"header-row\">\n\n            <div>\n\n                <div class=\"hospital-status-title\">\n                    🏥 LIVE HOSPITAL AVAILABILITY\n                </div>\n\n                <div class=\"hospital-status-subtitle\">\n                    Real-time hospital capacity, capabilities and eligibility\n                </div>\n\n            </div>\n\n\n            <div\n                class=\"mode-pill\"\n                :class=\"\n                    emergencyActive\n                    ? 'mode-emergency'\n                    : 'mode-normal'\n                \"\n            >\n\n                {{\n                    emergencyActive\n                    ? \"🚨 EMERGENCY MODE\"\n                    : \"🟢 NORMAL MODE\"\n                }}\n\n            </div>\n\n        </div>\n\n\n        <div\n            v-if=\"caseActive\"\n            class=\"patient-strip\"\n        >\n\n            🩺 Current Patient:\n\n            <strong>\n                {{ patientCondition }}\n            </strong>\n\n        </div>\n\n\n        <div\n            v-else\n            class=\"no-case-strip\"\n        >\n            ✅ No active patient case\n        </div>\n\n\n        <div class=\"hospital-grid\">\n\n            <div\n                v-for=\"hospital in hospitals\"\n                :key=\"hospital.name\"\n                class=\"hospital-card\"\n                :class=\"'card-' + hospital.statusLevel\"\n            >\n\n                <!-- HOSPITAL NAME -->\n\n                <div class=\"hospital-name\">\n\n                    🏥 {{ hospital.name }}\n\n                </div>\n\n\n                <!-- OVERALL AVAILABILITY -->\n\n                <div\n                    class=\"status-banner\"\n                    :class=\"'banner-' + hospital.statusLevel\"\n                >\n\n                    {{ hospital.statusIcon }}\n\n                    {{ hospital.statusText }}\n\n                </div>\n\n\n                <!-- CAPABILITIES -->\n\n                <div class=\"capabilities-box\">\n\n                    <div class=\"small-label\">\n                        🩺 CAPABILITIES\n                    </div>\n\n                    <strong>\n                        {{ hospital.specialties.join(\", \") }}\n                    </strong>\n\n                </div>\n\n\n                <!-- PATIENT MATCH -->\n\n                <div\n                    v-if=\"caseActive\"\n                    class=\"patient-match\"\n                    :class=\"\n                        supportsPatient(hospital)\n                        ? 'match-yes'\n                        : 'match-no'\n                    \"\n                >\n\n                    <span v-if=\"supportsPatient(hospital)\">\n                        ✅ Supports {{ patientCondition }}\n                    </span>\n\n                    <span v-else>\n                        ❌ Does not support {{ patientCondition }}\n                    </span>\n\n                </div>\n\n\n                <!-- ED -->\n\n                <div class=\"data-row\">\n\n                    <span>\n                        🚨 Emergency Department\n                    </span>\n\n                    <strong\n                        v-if=\"hospital.emergencyAccepting\"\n                        class=\"green-text\"\n                    >\n                        ACCEPTING\n                    </strong>\n\n                    <strong\n                        v-else\n                        class=\"red-text\"\n                    >\n                        CLOSED\n                    </strong>\n\n                </div>\n\n\n                <!-- ER BEDS -->\n\n                <div class=\"data-row\">\n\n                    <span>\n                        🛏 ER Beds\n                    </span>\n\n                    <strong\n                        :class=\"\n                            hospital.erBedsAvailable > 0\n                            ? 'green-text'\n                            : 'red-text'\n                        \"\n                    >\n                        {{ hospital.erBedsAvailable }}\n                    </strong>\n\n                </div>\n\n\n                <!-- ADMITTING BEDS -->\n\n                <div class=\"data-row\">\n\n                    <span>\n                        🏨 Admitting Beds\n                    </span>\n\n                    <strong\n                        :class=\"\n                            hospital.admittingBedsAvailable > 0\n                            ? 'green-text'\n                            : 'red-text'\n                        \"\n                    >\n                        {{ hospital.admittingBedsAvailable }}\n                    </strong>\n\n                </div>\n\n\n                <!-- NORMAL / EMERGENCY AVAILABILITY -->\n\n                <div class=\"availability-grid\">\n\n                    <div\n                        class=\"availability-box\"\n                        :class=\"\n                            hospital.emergencyAvailable\n                            ? 'available'\n                            : 'unavailable'\n                        \"\n                    >\n\n                        <div>\n                            🚨 Emergency Reception\n                        </div>\n\n                        <strong>\n\n                            {{\n                                hospital.emergencyAvailable\n                                ? \"AVAILABLE\"\n                                : \"NOT AVAILABLE\"\n                            }}\n\n                        </strong>\n\n                    </div>\n\n\n                    <div\n                        class=\"availability-box\"\n                        :class=\"\n                            hospital.normalAvailable\n                            ? 'available'\n                            : 'unavailable'\n                        \"\n                    >\n\n                        <div>\n                            🟢 Normal Admission\n                        </div>\n\n                        <strong>\n\n                            {{\n                                hospital.normalAvailable\n                                ? \"AVAILABLE\"\n                                : \"NOT AVAILABLE\"\n                            }}\n\n                        </strong>\n\n                    </div>\n\n                </div>\n\n\n                <!-- CURRENT MODE ELIGIBILITY -->\n\n                <div\n                    v-if=\"caseActive\"\n                    class=\"eligibility-box\"\n                    :class=\"\n                        currentEligible(hospital)\n                        ? 'eligible'\n                        : 'not-eligible'\n                    \"\n                >\n\n                    <span\n                        v-if=\"currentEligible(hospital)\"\n                    >\n\n                        ✅ ELIGIBLE FOR CURRENT CASE\n\n                    </span>\n\n                    <span v-else>\n\n                        ❌ NOT ELIGIBLE FOR CURRENT CASE\n\n                    </span>\n\n                </div>\n\n\n                <div\n                    v-else\n                    class=\"eligibility-box no-case\"\n                >\n\n                    ⏸ WAITING FOR PATIENT CASE\n\n                </div>\n\n\n                <div class=\"updated\">\n\n                    Last Updated:\n                    {{ hospital.lastUpdated }}\n\n                </div>\n\n            </div>\n\n        </div>\n\n    </div>\n\n</template>\n\n\n<script>\n\nexport default {\n\n    data() {\n\n        return {\n\n            patientCondition:\n                \"GENERAL\",\n\n\n            emergencyActive:\n                false,\n\n\n            caseActive:\n                true,\n\n\n            hospitals: [\n\n                {\n\n                    name:\n                        \"SIM HOSPITAL A\",\n\n                    specialties: [\n                        \"GENERAL\",\n                        \"TRAUMA\"\n                    ],\n\n                    emergencyAccepting:\n                        false,\n\n                    erBedsAvailable:\n                        0,\n\n                    admittingBedsAvailable:\n                        8,\n\n                    emergencyAvailable:\n                        false,\n\n                    normalAvailable:\n                        true,\n\n                    statusLevel:\n                        \"yellow\",\n\n                    statusIcon:\n                        \"🟡\",\n\n                    statusText:\n                        \"NORMAL ADMISSION ONLY\",\n\n                    lastUpdated:\n                        \"Waiting...\"\n                },\n\n\n                {\n\n                    name:\n                        \"SIM HOSPITAL B\",\n\n                    specialties: [\n                        \"GENERAL\",\n                        \"CARDIAC\"\n                    ],\n\n                    emergencyAccepting:\n                        true,\n\n                    erBedsAvailable:\n                        2,\n\n                    admittingBedsAvailable:\n                        6,\n\n                    emergencyAvailable:\n                        true,\n\n                    normalAvailable:\n                        true,\n\n                    statusLevel:\n                        \"green\",\n\n                    statusIcon:\n                        \"🟢\",\n\n                    statusText:\n                        \"EMERGENCY + ADMISSION AVAILABLE\",\n\n                    lastUpdated:\n                        \"Waiting...\"\n                },\n\n\n                {\n\n                    name:\n                        \"SIM HOSPITAL C\",\n\n                    specialties: [\n                        \"GENERAL\",\n                        \"TRAUMA\",\n                        \"CARDIAC\"\n                    ],\n\n                    emergencyAccepting:\n                        true,\n\n                    erBedsAvailable:\n                        3,\n\n                    admittingBedsAvailable:\n                        3,\n\n                    emergencyAvailable:\n                        true,\n\n                    normalAvailable:\n                        true,\n\n                    statusLevel:\n                        \"green\",\n\n                    statusIcon:\n                        \"🟢\",\n\n                    statusText:\n                        \"EMERGENCY + ADMISSION AVAILABLE\",\n\n                    lastUpdated:\n                        \"Waiting...\"\n                }\n\n            ]\n\n        };\n\n    },\n\n\n    watch: {\n\n        msg: {\n\n            handler(newMsg) {\n\n                this.processMessage(\n                    newMsg\n                );\n\n            },\n\n\n            deep:\n                true\n\n        }\n\n    },\n\n\n    mounted() {\n\n        this.processMessage(\n            this.msg\n        );\n\n    },\n\n\n    methods: {\n\n\n        // =====================================\n        // MESSAGE ROUTER\n        // =====================================\n\n        processMessage(\n            msg\n        ) {\n\n            if (\n                !msg\n            ) {\n\n                return;\n            }\n\n\n            // =================================\n            // HOSPITAL AVAILABILITY UPDATE\n            // =================================\n\n            if (\n                msg.payload &&\n                msg.payload.type ===\n                    \"hospital_status_display\"\n\n                &&\n\n                Array.isArray(\n                    msg.payload.hospitals\n                )\n            ) {\n\n                msg.payload.hospitals.forEach(\n\n                    update => {\n\n                        const hospital =\n                            this.hospitals.find(\n\n                                item =>\n\n                                    item.name ===\n                                    update.name\n                            );\n\n\n                        if (\n                            !hospital\n                        ) {\n\n                            return;\n                        }\n\n\n                        hospital.emergencyAccepting =\n                            update.emergencyAccepting ===\n                                true;\n\n\n                        hospital.erBedsAvailable =\n                            Math.max(\n\n                                0,\n\n                                Number(\n                                    update.erBedsAvailable\n                                ) || 0\n                            );\n\n\n                        hospital.admittingBedsAvailable =\n                            Math.max(\n\n                                0,\n\n                                Number(\n                                    update.admittingBedsAvailable\n                                ) || 0\n                            );\n\n\n                        hospital.emergencyAvailable =\n                            update.emergencyAvailable ===\n                                true;\n\n\n                        hospital.normalAvailable =\n                            update.normalAvailable ===\n                                true;\n\n\n                        hospital.statusLevel =\n                            update.statusLevel ||\n                            \"red\";\n\n\n                        hospital.statusIcon =\n                            update.statusIcon ||\n                            \"🔴\";\n\n\n                        hospital.statusText =\n                            update.statusText ||\n                            \"NOT AVAILABLE\";\n\n\n                        hospital.lastUpdated =\n                            update.lastUpdated ||\n                            \"Waiting...\";\n                    }\n                );\n\n\n                return;\n            }\n\n\n            // =================================\n            // PATIENT CASE\n            // =================================\n\n            if (\n                msg.payload &&\n                msg.payload.type ===\n                    \"patient_case\"\n            ) {\n\n                const condition =\n                    String(\n\n                        msg.payload.patientCondition ||\n                        \"GENERAL\"\n\n                    ).toUpperCase();\n\n\n                if (\n                    [\n                        \"GENERAL\",\n                        \"TRAUMA\",\n                        \"CARDIAC\"\n                    ].includes(\n                        condition\n                    )\n                ) {\n\n                    this.patientCondition =\n                        condition;\n\n\n                    this.caseActive =\n                        true;\n                }\n\n\n                return;\n            }\n\n\n            // =================================\n            // COMPLETE CASE\n            // =================================\n\n            if (\n                msg.payload &&\n                msg.payload.type ===\n                    \"complete_case\"\n            ) {\n\n                this.caseActive =\n                    false;\n\n\n                this.emergencyActive =\n                    false;\n\n\n                return;\n            }\n\n\n            // =================================\n            // NORMAL / EMERGENCY\n            // =================================\n\n            if (\n                typeof msg.payload ===\n                    \"string\"\n            ) {\n\n                if (\n                    msg.payload.includes(\n                        \"EMERGENCY ACTIVE\"\n                    )\n                ) {\n\n                    this.emergencyActive =\n                        true;\n\n\n                    return;\n                }\n\n\n                if (\n                    msg.payload.includes(\n                        \"NORMAL\"\n                    )\n                ) {\n\n                    this.emergencyActive =\n                        false;\n                }\n\n            }\n\n        },\n\n\n        // =====================================\n        // SPECIALTY SUPPORT\n        // =====================================\n\n        supportsPatient(\n            hospital\n        ) {\n\n            return (\n\n                Array.isArray(\n                    hospital.specialties\n                )\n\n                &&\n\n                hospital.specialties.includes(\n                    this.patientCondition\n                )\n            );\n\n        },\n\n\n        // =====================================\n        // NORMAL ELIGIBILITY\n        // =====================================\n\n        normalEligible(\n            hospital\n        ) {\n\n            return (\n\n                this.supportsPatient(\n                    hospital\n                )\n\n                &&\n\n                hospital.admittingBedsAvailable >\n                    0\n            );\n\n        },\n\n\n        // =====================================\n        // EMERGENCY ELIGIBILITY\n        // =====================================\n\n        emergencyEligible(\n            hospital\n        ) {\n\n            return (\n\n                this.supportsPatient(\n                    hospital\n                )\n\n                &&\n\n                hospital.emergencyAccepting ===\n                    true\n\n                &&\n\n                hospital.erBedsAvailable >\n                    0\n            );\n\n        },\n\n\n        // =====================================\n        // CURRENT CASE ELIGIBILITY\n        // =====================================\n\n        currentEligible(\n            hospital\n        ) {\n\n            if (\n                !this.caseActive\n            ) {\n\n                return false;\n            }\n\n\n            if (\n                this.emergencyActive\n            ) {\n\n                return this.emergencyEligible(\n                    hospital\n                );\n            }\n\n\n            return this.normalEligible(\n                hospital\n            );\n\n        }\n\n    }\n\n};\n\n</script>\n\n\n<style>\n\n.hospital-status-wrapper {\n\n    padding:\n        8px;\n\n}\n\n\n.header-row {\n\n    display:\n        flex;\n\n    justify-content:\n        space-between;\n\n    align-items:\n        center;\n\n    gap:\n        15px;\n\n    margin-bottom:\n        10px;\n\n}\n\n\n.hospital-status-title {\n\n    font-size:\n        22px;\n\n    font-weight:\n        800;\n\n}\n\n\n.hospital-status-subtitle {\n\n    margin-top:\n        3px;\n\n    opacity:\n        0.65;\n\n}\n\n\n.mode-pill {\n\n    padding:\n        8px 12px;\n\n    border-radius:\n        20px;\n\n    font-weight:\n        800;\n\n    white-space:\n        nowrap;\n\n}\n\n\n.mode-normal {\n\n    background:\n        #e8f7ed;\n\n    border:\n        1px solid #2e7d32;\n\n}\n\n\n.mode-emergency {\n\n    background:\n        #ffe4e4;\n\n    border:\n        1px solid #c62828;\n\n}\n\n\n.patient-strip {\n\n    margin-bottom:\n        12px;\n\n    padding:\n        8px 12px;\n\n    border:\n        1px solid #7e57c2;\n\n    border-radius:\n        6px;\n\n    background:\n        #f4efff;\n\n}\n\n\n.no-case-strip {\n\n    margin-bottom:\n        12px;\n\n    padding:\n        8px 12px;\n\n    border:\n        1px solid #2e7d32;\n\n    border-radius:\n        6px;\n\n    background:\n        #e8f7ed;\n\n}\n\n\n.hospital-grid {\n\n    display:\n        grid;\n\n    grid-template-columns:\n        repeat(\n            3,\n            minmax(\n                0,\n                1fr\n            )\n        );\n\n    gap:\n        12px;\n\n}\n\n\n.hospital-card {\n\n    padding:\n        14px;\n\n    border-radius:\n        9px;\n\n    border:\n        2px solid #cccccc;\n\n    background:\n        #ffffff;\n\n}\n\n\n.card-green {\n\n    border-color:\n        #2e7d32;\n\n    background:\n        #edf8ef;\n\n}\n\n\n.card-yellow {\n\n    border-color:\n        #f9a825;\n\n    background:\n        #fff9df;\n\n}\n\n\n.card-red {\n\n    border-color:\n        #c62828;\n\n    background:\n        #ffeded;\n\n}\n\n\n.hospital-name {\n\n    font-size:\n        18px;\n\n    font-weight:\n        800;\n\n    margin-bottom:\n        8px;\n\n}\n\n\n.status-banner {\n\n    padding:\n        7px;\n\n    border-radius:\n        5px;\n\n    font-size:\n        12px;\n\n    font-weight:\n        800;\n\n    margin-bottom:\n        10px;\n\n}\n\n\n.banner-green {\n\n    border:\n        1px solid #2e7d32;\n\n    background:\n        #dff3e3;\n\n}\n\n\n.banner-yellow {\n\n    border:\n        1px solid #f9a825;\n\n    background:\n        #fff0b3;\n\n}\n\n\n.banner-red {\n\n    border:\n        1px solid #c62828;\n\n    background:\n        #ffdede;\n\n}\n\n\n.capabilities-box {\n\n    padding:\n        8px;\n\n    margin-bottom:\n        8px;\n\n    border-radius:\n        5px;\n\n    background:\n        rgba(\n            255,\n            255,\n            255,\n            0.55\n        );\n\n}\n\n\n.small-label {\n\n    margin-bottom:\n        3px;\n\n    font-size:\n        10px;\n\n    font-weight:\n        800;\n\n    opacity:\n        0.65;\n\n}\n\n\n.patient-match {\n\n    margin-bottom:\n        7px;\n\n    padding:\n        6px;\n\n    border-radius:\n        5px;\n\n    font-weight:\n        700;\n\n}\n\n\n.match-yes {\n\n    background:\n        #ddf3e2;\n\n}\n\n\n.match-no {\n\n    background:\n        #ffe1e1;\n\n}\n\n\n.data-row {\n\n    display:\n        flex;\n\n    justify-content:\n        space-between;\n\n    gap:\n        10px;\n\n    padding:\n        8px 0;\n\n    border-bottom:\n        1px solid rgba(\n            0,\n            0,\n            0,\n            0.10\n        );\n\n}\n\n\n.green-text {\n\n    color:\n        #1b5e20;\n\n}\n\n\n.red-text {\n\n    color:\n        #b71c1c;\n\n}\n\n\n.availability-grid {\n\n    display:\n        grid;\n\n    grid-template-columns:\n        1fr 1fr;\n\n    gap:\n        8px;\n\n    margin-top:\n        12px;\n\n}\n\n\n.availability-box {\n\n    padding:\n        9px;\n\n    border-radius:\n        6px;\n\n    text-align:\n        center;\n\n    font-size:\n        12px;\n\n}\n\n\n.available {\n\n    border:\n        1px solid #2e7d32;\n\n    background:\n        #dff3e3;\n\n}\n\n\n.unavailable {\n\n    border:\n        1px solid #c62828;\n\n    background:\n        #ffe2e2;\n\n}\n\n\n.eligibility-box {\n\n    margin-top:\n        10px;\n\n    padding:\n        9px;\n\n    border-radius:\n        6px;\n\n    text-align:\n        center;\n\n    font-weight:\n        800;\n\n}\n\n\n.eligible {\n\n    border:\n        1px solid #2e7d32;\n\n    background:\n        #dff3e3;\n\n}\n\n\n.not-eligible {\n\n    border:\n        1px solid #c62828;\n\n    background:\n        #ffe2e2;\n\n}\n\n\n.no-case {\n\n    border:\n        1px solid #999999;\n\n    background:\n        #eeeeee;\n\n}\n\n\n.updated {\n\n    margin-top:\n        9px;\n\n    font-size:\n        11px;\n\n    opacity:\n        0.65;\n\n}\n\n\n@media (\n    max-width:\n        900px\n) {\n\n    .hospital-grid {\n\n        grid-template-columns:\n            1fr;\n\n    }\n\n\n    .header-row {\n\n        align-items:\n            flex-start;\n\n        flex-direction:\n            column;\n\n    }\n\n}\n\n</style>",
        "storeOutMessages": true,
